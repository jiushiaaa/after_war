  },
  {
    "id": "e22ccf4e42c0467e",
    "text": "A ragged stranger staggers through the door and collapses in a corner"
  },
  {
    "id": "7bfe914e4a74ba2f",
    "text": "The stranger shivers and mutters continuously, but it is impossible to make out what she is saying"
  },
  {
    "id": "aca5ebaef2a5964a",
    "text": "The stranger in the corner has stopped trembling. Her breathing has calmed"
  },
  {
