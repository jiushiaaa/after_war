  },
  {
    "id": "b1e9f867aa6c8682",
    "text": "Destroyed Village"
  },
  {
    "id": "5d60db685dc4afa6",
    "text": "Water:{0}"
  },
  {
    "id": "015845346aa9dc94",
    "text": "Backpack"
  },
  {
    "id": "2f6c31fb268df455",
    "text": "Health: {0}/{1}"
  },
  {
    "id": "46a74f734735c78d",
    "text": "Leaving the village without proper protection makes long journeys dangerous"
  },
  {
    "id": "b08c921ca9856ddc",
    "text": "This place is safe enough"
  },
  {
    "id": "3ee46acd58347ceb",
    "text": "The meat is gone"
  },
  {
    "id": "d43315ceb9bb0f4e",
    "text": "Hunger sets in"
  },
  {
    "id": "07ff8dc87e13f84c",
    "text": "The water is gone"
  },
  {
    "id": "1e6027f2630b42ac",
    "text": "Thirst becomes unbearable"
  },
  {
    "id": "47710ea592ef338b",
    "text": "Trees lie crooked among the dry grass, while yellowed shrubs rustle in the wind"
  },
  {
    "id": "e3fedf7eac361aa8",
    "text": "The trees are gone, leaving only cracked earth and blowing dust"
  },
  {
    "id": "f7f4325cabfc04ca",
    "text": "A forest is barely visible on the horizon. The grassland thins, giving way to a forest carpeted with dead branches and fallen leaves"
  },
  {
    "id": "8e85f8cbe3d242c4",
    "text": "The grassland quickly thins, leaving only dust filling the air"
  },
  {
    "id": "54b9ecd6393eedb6",
    "text": "Wild grass sways like a sea in the hot, dry wind, with a wasteland exposed in its midst"
  },
  {
    "id": "b510fbbbe78dbdc5",
    "text": "Knotted walls of trees rise from the dust, their branches twisting overhead into a skeletal canopy"
  },
  {
    "id": "4fb6abc2f6039a6f",
    "text": "Wanderer"
  },
  {
    "id": "71580f54ce84a286",
    "text": "Village"
  },
  {
    "id": "7aa07d292d786661",
    "text": "The world before us dissolved into nothing"
  },
  {
    "id": "3b737531e8e06a6a",
    "text": "Water replenished"
  },
  {
    "id": "3ade6191e870cbbf",
    "text": "Wasteland"
  },
  {
    "id": "0cfb8e5b4b9078d5",
    "text": "Roaring Beast"
  },
  {
    "id": "c85d900505a78d50",
    "text": "The beast fell"
  },
  {
    "id": "b46c437cba17ec31",
    "text": "A beast sprang from the bushes"
  },
  {
    "id": "aebe24d4e7cb965c",
    "text": "Emaciated Man"
  },
  {
    "id": "84e3e24c27a18737",
    "text": "The emaciated man fell"
  },
  {
    "id": "8f13c0f26ab31bd2",
    "text": "An emaciated man approached, madness in his eyes"
  },
  {
    "id": "9e7b7a0707a88646",
    "text": "Strange Bird"
  },
  {
    "id": "3dbc4f1f2930050c",
    "text": "The strange bird fell"
  },
  {
    "id": "a66192e1875ff5f1",
    "text": "A strange-looking bird swept quickly across the plains"
  },
  {
    "id": "a904d013698a1582",
    "text": "Trembling Man"
  },
  {
    "id": "8f95b0127cdf6635",
    "text": "The trembling man fell"
  },
  {
    "id": "f29dce08a7563bea",
    "text": "A trembling man approached and attacked with astonishing strength"
  },
  {
    "id": "21e3a97a6c88153c",
    "text": "Cannibal Monster"
  },
  {
    "id": "0388b4c60a39d5d3",
    "text": "The cannibal monster fell"
  },
  {
    "id": "a4ab441f36bd9322",
    "text": "A huge creature attacked, its claws dripping with blood"
  },
  {
    "id": "502c2ff880ffe0df",
    "text": "Scavenger"
  },
  {
    "id": "4bdfb0163fd2cf0c",
    "text": "The scavenger was eliminated"
  },
  {
    "id": "5a8fd7e836254977",
    "text": "A scavenger crept close, trying to launch a surprise attack"
  },
  {
    "id": "6be2a81c04866b63",
    "text": "Giant Lizard"
  },
  {
    "id": "33d0b9de661b6c84",
    "text": "The giant lizard fell"
  },
  {
    "id": "2c54198014d2f9c6",
    "text": "The grass shook wildly as a giant lizard sprang out"
  },
  {
    "id": "426b2d02785eb728",
    "text": "Savage Beast"
  },
  {
    "id": "1bac1b4d5cdf40eb",
    "text": "The savage beast fell"
  },
  {
    "id": "def902505249d5a7",
    "text": "A savage beast sprang from the forest with unimaginable ferocity"
  },
  {
    "id": "eaa8dd04fd6812c8",
    "text": "Soldier"
  },
  {
    "id": "1566ec2445a23bd2",
    "text": "The soldier fell"
  },
  {
    "id": "1c318a13f0ebfaab",
    "text": "A soldier opened fire from across the desert"
  },
  {
    "id": "cc51ac955b7c454e",
    "text": "Sniper"
  },
  {
    "id": "639011726ed6bb78",
    "text": "The sniper was eliminated"
  },
  {
    "id": "a67052d1cee1dcd7",
    "text": "A bullet was fired from somewhere in the tall grass"
  },
  {
    "id": "38ceca17e4aae786",
    "text": "The villagers dragged a filthy man out of the warehouse"
  },
  {
    "id": "f7a86a5b16e78521",
    "text": "His accomplices had reportedly already stolen a great deal of cargo"
  },
  {
    "id": "4a6994a398622c79",
    "text": "They say he should be hanged as a warning to others"
  },
  {
    "id": "857ec7913b53e355",
    "text": "A thief was caught"
  },
  {
    "id": "58ce25ca0447e48e",
    "text": "Hang him"
  },
  {
    "id": "24e77f105360ea8e",
    "text": "Release him"
  },
  {
    "id": "f0ba0eacca6c34a6",
    "text": "The villagers hanged the thief and displayed him high in front of the warehouse"
  }
]
